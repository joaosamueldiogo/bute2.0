{
  "title": "Senhor Jesus",
  "author": "",
  "category": "Taizé",
  "lyrics": [
    {
      "chords": "Bm       Em      A         D",
      "line": "Senhor Jesus, tu és luz do mundo:"
    },
    {
      "chords": "Bm         A          D     Em7   F#",
      "line": "dissipa as trevas que me querem falar."
    },
    {
      "chords": "Bm       Em      A           D",
      "line": "Senhor Jesus, és luz na minh'alma:"
    },
    {
      "chords": "G     Em7    Bm    F#   Bm",
      "line": "saiba eu acolher o teu amor."
    }
  ]

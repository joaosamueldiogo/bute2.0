{
  "title": "Não dormirá Aquele que te guarda",
  "author": "",
  "category": "",
  "lyrics": [
    {
      "chords": "D          A             Em",
      "line": "Levanto os olhos para os montes:"
    },
    {
      "chords": "D                A",
      "line": "De onde virá o auxílio?"
    },
    {
      "chords": "F#m     G     A",
      "line": "O meu auxílio vem"
    },
    {
      "chords": "F#m                  G       A",
      "line": "Do Senhor, que fez o céu e a terra."
    },
    {
      "chords": "D      A   Bm       F#m           G  A",
      "line": "Não permitirá que vacilem os teus passos,"
    },
    {
      "chords": "G        A   D     A      Bm F#m ",
      "line": "Não dormirá Aquele que te guarda."
    },
    {
      "chords": "F#m     Bm      F#m",
      "line": "Não há-de adormecer"
    },
    {
      "chords": "      Bm     F#m G",
      "line": "O que guarda Israel. (2x)"
    },
    {
      "chords": "G            A   D",
      "line": "O que guarda Israel."
    },
    {
      "chords": "D                  A",
      "line": "O Senhor é Quem te guarda,"
    },
    {
      "chords": "D                   A         Em       D  A",
      "line": "O Senhor está a teu lado, Ele é o teu abrigo."
    },
    {
      "chords": "F#m            G      A ",
      "line": "O sol não fará mal de dia,"
    },
    {
      "chords": "F#m         G       A ",
      "line": "Nem a lua durante a noite."
    },
    {
      "chords": "D             A        Em",
      "line": "O Senhor te defende do mal,"
    },
    {
      "chords": "D             A        Em",
      "line": "O Senhor vela pela tua vida."
    },
    {
      "chords": "F#m                   G            A",
      "line": "Ele te protege quando vais, quando vens,"
    },
    {
      "chords": "F#m   G      A",
      "line": "Agora e para sempre."
    }
  ]
}
